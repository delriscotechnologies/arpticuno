{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/delriscotechnologies/arpticuno/schemas/arpticuno-report.schema.json",
  "title": "Arpticuno report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "tool",
    "version",
    "scan_id",
    "command",
    "status",
    "started_at",
    "finished_at",
    "inputs",
    "hosts"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "tool": {"const": "Arpticuno"},
    "version": {"type": "string"},
    "scan_id": {"type": "string", "format": "uuid"},
    "command": {"const": "scan"},
    "status": {
      "enum": ["completed", "partial", "inconclusive", "no-open-ports", "no-arp-responders"]
    },
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "inputs": {"type": "object"},
    "hosts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ip", "mac", "arp_rtt_ms", "ports"],
        "properties": {
          "ip": {"type": "string", "format": "ipv4"},
          "mac": {"type": ["string", "null"]},
          "arp_rtt_ms": {"type": ["number", "null"], "minimum": 0},
          "probe_summary": {
            "type": "object",
            "required": ["total", "open", "closed", "timeout", "unreachable", "error"],
            "additionalProperties": false,
            "properties": {
              "total": {"type": "integer", "minimum": 0},
              "open": {"type": "integer", "minimum": 0},
              "closed": {"type": "integer", "minimum": 0},
              "timeout": {"type": "integer", "minimum": 0},
              "unreachable": {"type": "integer", "minimum": 0},
              "error": {"type": "integer", "minimum": 0}
            }
          },
          "ports": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["port", "proto", "state", "latency_ms", "error"],
              "properties": {
                "port": {"type": "integer", "minimum": 1, "maximum": 65535},
                "proto": {"const": "tcp"},
                "state": {"enum": ["open", "closed", "timeout", "unreachable", "error"]},
                "latency_ms": {"type": ["number", "null"], "minimum": 0},
                "error": {"type": ["string", "null"]}
              }
            }
          }
        }
      }
    }
  }
}
